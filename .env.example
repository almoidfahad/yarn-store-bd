# =============================================================================
# YARN STORE BD — MHR THREAD & ACCESSORIES
# Production Environment Variables (Vercel + Supabase + Resend)
# Copy this file to `.env.local` locally OR paste into Vercel Project Settings
# =============================================================================

# 1. PUBLIC SITE URL
NEXT_PUBLIC_SITE_URL=https://yarn-store-bd.vercel.app

# 2. SUPABASE POSTGRESQL + RLS
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# 3. RESEND TRANSACTIONAL EMAIL
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="YARN STORE BD Export Desk <onboarding@resend.dev>"
SALES_NOTIFICATION_EMAIL=info@yarnstorebd.com

# 4. OPTIONAL COMPANY DEMO / LIVE OVERRIDES
NEXT_PUBLIC_COMPANY_NAME="YARN STORE BD"
NEXT_PUBLIC_COMPANY_SUBBRAND="MHR THREAD & ACCESSORIES"
NEXT_PUBLIC_COMPANY_EMAIL="info@yarnstorebd.com"
NEXT_PUBLIC_COMPANY_PHONE="+880 1677 852904"
NEXT_PUBLIC_COMPANY_WHATSAPP="8801677852904"
NEXT_PUBLIC_COMPANY_ADDRESS="123 Textile Industrial Area, Dhaka, Bangladesh"
NEXT_PUBLIC_FACTORY_ADDRESS="Gazipur Ring Spinning & Auto-Coner Industrial Zone, Bangladesh"
NEXT_PUBLIC_ERC_NUMBER="ERC-BD-2014-88412"
NEXT_PUBLIC_IS_LIVE_DATA=false
